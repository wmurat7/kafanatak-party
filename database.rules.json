{
  "rules": {
    ".read": false,
    ".write": false,
    "kafanatak": {
      ".read": false,
      ".write": false,
      "content": {
        ".read": true,
        ".write": false
      },
      "questions": {
        ".read": true,
        ".write": false
      },
      "$namespace": {
        ".read": false,
        ".write": false,
        "$roomId": {
          ".read": "$roomId.matches(/^[a-zA-Z0-9_-]{2,24}$/)",
          ".write": "$roomId.matches(/^[a-zA-Z0-9_-]{2,24}$/)",
          ".indexOn": ["createdAt", "lastActive"]
        }
      }
    }
  }
}
